{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "eu.anthropic.claude-opus-5"
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(rm *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)"
    ]
  },
  "enabledPlugins": {
    "superpowers-ruby@superpowers-ruby": true,
    "ruby-lsp@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "plannotator@plannotator": true
  },
  "extraKnownMarketplaces": {
    "superpowers-ruby": {
      "source": {
        "source": "github",
        "repo": "lucianghinda/superpowers-ruby"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
