{
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(rm *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout * .)",
      "Bash(git push * --force*)",
      "Bash(git push * +*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean*)",
      "Bash(git -C * restore *)",
      "Bash(git -C * checkout -f*)",
      "Bash(git -C * checkout --force*)",
      "Bash(git -C * checkout -- *)",
      "Bash(git -C * checkout * -- *)",
      "Bash(git -C * checkout .)",
      "Bash(git -C * checkout * .)",
      "Bash(git -C * stash drop*)",
      "Bash(git -C * stash clear*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * +*)",
      "Bash(git -C * branch -D *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push -uf*)",
      "Bash(git -C * push * -uf*)"
    ]
  },
  "enabledPlugins": {
    "superpowers-ruby@superpowers-ruby": true,
    "ruby-lsp@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "plannotator@plannotator": false,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "superpowers-ruby": {
      "source": {
        "source": "github",
        "repo": "lucianghinda/superpowers-ruby"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "100000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/bin/claude-resume-cost\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/bin/claude-no-attribution\""
          }
        ]
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "switchModelsOnFlag": false,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
