#!/usr/bin/env bash
set -euo pipefail

if ! command -v python3 >/dev/null 2>&1; then
  echo 'ssh-keys-sync requires python3' >&2
  exit 1
fi

if ! command -v op >/dev/null 2>&1; then
  echo 'ssh-keys-sync requires the 1Password CLI: brew install 1password-cli' >&2
  exit 1
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "${script_dir}/../lib/ssh_keys_sync.py" "$@"
