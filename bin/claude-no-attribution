#!/usr/bin/env bash
# claude-no-attribution - Claude Code PreToolUse hook (matcher: Bash).
#
# Inspect submitted commit, PR and issue messages, including message files.
# Reads the hook JSON on stdin; never executes the command being inspected.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "${script_dir}/../lib/claude_no_attribution.py"
