#!/usr/bin/env bash
set -euo pipefail

# Colours
green() { printf "\033[32m%s\033[0m\n" "$*"; }
red() { printf "\033[31m%s\033[0m\n" "$*" >&2; }

DOTFILES_DIR="${HOME}/.dotfiles"

if ! command -v brew >/dev/null 2>&1; then
  red "ERROR: Homebrew is not installed."
  exit 1
fi

# git/gitconfig uses gh as the GitHub credential helper, so install and sign
# in to gh before anything clones from GitHub.
if ! command -v gh >/dev/null 2>&1; then
  green "Installing GitHub CLI..."
  brew install gh
fi
if ! gh auth status --hostname github.com >/dev/null 2>&1; then
  if [ -t 0 ]; then
    green "Signing in to GitHub..."
    gh auth login --hostname github.com --git-protocol https --web
  else
    red "WARNING: gh is not signed in to GitHub; run 'gh auth login' and re-run bootstrap."
  fi
fi

# Install Homebrew packages and everything else we need
green "Installing Homebrew packages..."
# Without --verbose, brew bundle captures each install's output and only prints
# it on failure, so prompts and progress never reach the terminal. Accept
# licences (e.g. microsoft/mssql-release) up front so the run is unattended.
export HOMEBREW_ACCEPT_EULA=Y
brew bundle install --verbose --no-upgrade --file="${DOTFILES_DIR}/Brewfile"

# restart_service: :changed only fires when brew bundle installs or upgrades
# atuin, so start the sync daemon explicitly. A no-op if it is already running.
green "Starting atuin service..."
brew services start atuin

# The git-credential-manager cask registers itself as the global credential
# helper, which overrides gh for GitHub. git/gitconfig scopes it to Azure DevOps.
if git config --global --get-all credential.helper 2>/dev/null | grep -q git-credential-manager; then
  git config --global --unset-all credential.helper
fi

# init runs before hk is installed on a fresh Mac.
(cd "${DOTFILES_DIR}" && hk install)

# Use Apple's local PAM include, which survives OS updates. Never replace an
# existing local policy or edit /etc/pam.d/sudo itself.
if [ -f /etc/pam.d/sudo_local.template ] && [ ! -e /etc/pam.d/sudo_local ]; then
  green "Enabling Touch ID for sudo..."
  sudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local
  sudo sed -i '' 's/^#auth/auth/' /etc/pam.d/sudo_local
fi

# Enable the Application Firewall (idempotent)
if [ "$(sudo /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null)" != "Firewall is enabled. (State = 1)" ]; then
  green "Enabling Application Firewall..."
  sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on >/dev/null
fi

# Install the global tools seeded by init, not a calling project's tools.
# mise doctor expects shell activation and is not a bootstrap prerequisite.
green "Installing mise dependencies..."
(cd "${HOME}" && mise install -y)

echo
green "bootstrap complete."
echo

# Pause for confirmation before proceeding
if [ -t 0 ]; then
  printf "Press Enter to continue to the next step..." >&2
  read -r </dev/tty
fi
